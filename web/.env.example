# Local dev DB (login role radhe owns both DBs; setup steps in CLAUDE.md "Commands")
DATABASE_URL=postgres://radhe:CHANGE_ME@localhost:5432/radhe_dev
# pnpm test wipes and re-migrates this DB; its name must end in _test
TEST_DATABASE_URL=postgres://radhe:CHANGE_ME@localhost:5432/radhe_test
# Better Auth (D04): a random secret of 32+ characters, and the app's own URL
BETTER_AUTH_SECRET=CHANGE_ME
BETTER_AUTH_URL=http://localhost:3000
# pnpm db:seed creates this owner while no owner exists
OWNER_USERNAME=
OWNER_PASSWORD=
OWNER_NAME=
# Email (D07): quotations / invoices are emailed with the PDF attached. Blank = email is off ("Email isn't set up").
# Port 465 = TLS, 587 = STARTTLS. MAIL_FROM e.g. "Radhe Digital Sign Board <accounts@example.com>".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
