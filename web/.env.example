# Local dev DB (login role radhe owns both DBs; setup steps in CLAUDE.md "Commands").
# Production (docs/DEPLOY.md): Supabase's transaction pooler URL, port 6543, ending ?sslmode=require
DATABASE_URL=postgres://radhe:CHANGE_ME@localhost:5432/radhe_dev
# Migrations (drizzle-kit) and pg_dump use this when set: production = Supabase's session pooler / direct URL
# (port 5432, ?sslmode=require). Blank = DATABASE_URL (local dev).
DIRECT_DATABASE_URL=
# pnpm test wipes and re-migrates this DB; its name must end in _test
TEST_DATABASE_URL=postgres://radhe:CHANGE_ME@localhost:5432/radhe_test
# Better Auth (D04): a random secret of 32+ characters, and the app's own URL (https:// in production; the start-up
# check refuses anything else except http://localhost)
BETTER_AUTH_SECRET=CHANGE_ME
BETTER_AUTH_URL=http://localhost:3000
# pnpm db:seed creates this owner while no owner exists
OWNER_USERNAME=
OWNER_PASSWORD=
OWNER_NAME=
# Email (D07): quotations / invoices are emailed with the PDF attached. Blank = email is off ("Email isn't set up").
# Port 465 = TLS, 587 = STARTTLS. MAIL_FROM e.g. "Radhe Digital Sign Board <accounts@example.com>".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Files (D08, D34): local = web/uploads; supabase = the private bucket below, through the Storage REST API. The key is
# the project's secret key (sb_secret_...) or legacy service_role key: server only, never in the browser.
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=
# pnpm db:backup: the folder holding pg_dump (blank = PATH, then PostgreSQL 16's bin) and where dumps go
# (blank = web/backups); old dumps there are pruned to 7 daily / 4 weekly / 12 monthly
PG_BIN=
BACKUP_DIR=
# pnpm smoke <url>: a real login to include the sign-in check (blank = skipped)
SMOKE_USER=
SMOKE_PASSWORD=
